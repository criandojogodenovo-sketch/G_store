# ───────────────────────────────────────────────────────────────
# G Store API (Ktor) — variáveis de ambiente NECESSÁRIAS
#
# SEGURANÇA: este arquivo contém apenas NOMES/placeholders.
# NUNCA coloque valores reais em arquivos versionados.
# Copie para .env (ignorado pelo Git) ou configure no ambiente.
# ───────────────────────────────────────────────────────────────

# OBRIGATÓRIA: connection string do Neon PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.aws.neon.tech/neondb?sslmode=require"

# Porta HTTP da API (padrão 8080)
PORT=8080

# ── Appwrite (autenticação) ────────────────────────────────────
# Endpoint e Project ID são configurações PÚBLICAS do cliente.
# A API key é SEGREDO e fica apenas no backend.
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="seu-project-id"
APPWRITE_API_KEY="standard_sua-api-key-secreta"

# ── GitHub Releases (hospedagem de APKs) ───────────────────────
# Token com escopo "repo" para criar releases/assets. NUNCA versionar.
GITHUB_TOKEN="ghp_ou_github_pat_seu-token"
# Repositório onde os APKs são hospedados (owner/repo)
GITHUB_RELEASES_REPO="criandojogodenovo-sketch/G_store"
# Se o repositório de releases for privado, a API faz stream do asset
# com o token server-side (em vez de redirect 302 público).
GITHUB_RELEASES_PRIVATE="false"

# ── Operacional (opcional) ─────────────────────────────────────
# E-mails que nascem como ADMIN ao sincronizar (separados por vírgula)
ADMIN_EMAILS="voce@exemplo.com"
# Limite de upload do APK em MB (padrão 200)
MAX_UPLOAD_MB=200
# NUNCA usar "true" em produção: desabilita a validação JWT
AUTH_DISABLED="false"
