# ───────────────────────────────────────────────────────────────
# G Store — variáveis de ambiente (arquivo de EXEMPLO)
#
# SEGURANÇA: este arquivo contém apenas NOMES/valores PÚBLICOS do
# cliente Android. NUNCA coloque segredos em arquivos versionados.
#
# Arquitetura atual (sem servidor próprio):
#   - App Android (Kotlin/Compose)
#   - Neon Auth    → login/registo/sessão
#   - Neon Data API→ REST sobre o Postgres (protegido por RLS)
#   - GitHub Releases → hospedagem dos APKs
#   - GitHub Actions → CI + release assinada
# ───────────────────────────────────────────────────────────────

# ── Neon Auth (públicos — vão dentro do APK de qualquer forma) ──
# URL base do serviço de autenticação (Neon Console → Auth)
NEON_AUTH_URL="https://SEU-PROJECT.neonauth.SUA-REGIAO.aws.neon.tech/neondb/auth"

# ── Neon Data API (público) ────────────────────────────────────
# URL base da Data API (Neon Console → Data API)
NEON_DATA_API_URL="https://SEU-PROJECT.apirest.SUA-REGIAO.aws.neon.tech/neondb/rest/v1"

# ── Origem de confiança usada pelo app nas chamadas ao Neon Auth ──
# Tem de estar na lista de trusted origins do Neon Auth
# (Console → Auth → Configuration → Trusted origins)
NEON_AUTH_ORIGIN="https://gstore.app"

# ── Neon PostgreSQL (SEGREDO — apenas para migrações/admin) ─────
# NUNCA vai para o app nem para o CI. Usado só localmente.
# DATABASE_URL="postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.aws.neon.tech/neondb?sslmode=require"

# ── GitHub Releases (hospedagem de APKs) ───────────────────────
# Repositório público onde os APKs ficam (as URLs ficam na tabela
# game_versions — o app baixa direto do GitHub, sem token).
GITHUB_RELEASES_REPO="criandojogodenovo-sketch/G_store"
